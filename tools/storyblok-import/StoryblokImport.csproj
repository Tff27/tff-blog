<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Tff.Tools.StoryblokImport</RootNamespace>
    <AssemblyName>Tff.Tools.StoryblokImport</AssemblyName>
    <UserSecretsId>tff-blog-storyblok-import</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UserSecretsId" Value="$(UserSecretsId)" />
  </ItemGroup>

</Project>
