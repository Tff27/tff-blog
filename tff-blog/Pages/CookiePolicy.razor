@page "/cookie-policy"
@inject IBlogContentService ContentService
@inject NavigationManager UriHelper

@if (errorMessage is not null)
{
    <ContentError ErrorMessage="@errorMessage" OnRetry="LoadCookiePolicyAsync" />
}
else if (cookiePolicyModel is not null)
{
    <Markdown MarkdownContent="@cookiePolicyModel.Text" />
}

@code {
    private CookiePolicyModel? cookiePolicyModel;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadCookiePolicyAsync();

    private async Task LoadCookiePolicyAsync()
    {
        errorMessage = null;

        var result = await ContentService.GetMarkdownPageAsync<CookiePolicyModel>("cookie-policy");

        if (result.IsNotFound)
        {
            UriHelper.NavigateTo("404", replace: true);
            return;
        }

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        cookiePolicyModel = result.Content;
    }
}
