@page "/post/{slug}"
@inject IBlogContentService ContentService
@inject NavigationManager UriHelper

@if (errorMessage is not null)
{
    <ContentError ErrorMessage="@errorMessage" OnRetry="LoadPostAsync" />
}
else if (postdetails == null)
{
    <HeadContent>
        <meta property="og:image" content=@($"{UriHelper.BaseUri}/images/logo_icon.png")>
    </HeadContent>

    <div class="post-skeleton" aria-hidden="true">
        <div class="skeleton-line skeleton-line--sm"></div>
        <div class="skeleton-line skeleton-line--lg"></div>
        <div class="skeleton-line"></div>
    </div>
    <p class="visually-hidden" role="status">Loading post…</p>
}
else
{
    <PageTitle>@postdetails.Title</PageTitle>

    <HeadContent>
        <CanonicalLink />

        <meta name="description" content="@postdetails.Description" />

        <meta property="og:url" content="@CanonicalUrl.From(UriHelper.Uri)">
        <meta property="og:title" content="@postdetails.Title">
        <meta property="og:image" content="@postdetails.Image">
        <meta property="og:image:alt" content="@postdetails.Title">
        <meta property="og:description" content="@postdetails.ShareDescription">
        <meta property="og:type" content="article">

        <meta name="twitter:url" content="@CanonicalUrl.From(UriHelper.Uri)">
        <meta name="twitter:title" content="@postdetails.Title">
        <meta name="twitter:description" content="@postdetails.ShareDescription">
        <meta name="twitter:image" content="@postdetails.Image">
        <meta name="twitter:image:alt" content="@postdetails.Title">
    </HeadContent>

    <article class="post">
        <header class="post-header">
            <div class="post-meta">
                <time datetime="@postdetails.IsoDate">@postdetails.FormattedDate</time>
                <span aria-hidden="true">·</span>
                <span>@postdetails.ReadTime</span>
            </div>

            <h1>@postdetails.Title</h1>

            @if (!string.IsNullOrWhiteSpace(postdetails.Description))
            {
                <p class="post-description">@postdetails.Description</p>
            }

            @if (postdetails.Tags.Any())
            {
                <ul class="tag-list" aria-label="Tags">
                    @foreach (var tag in postdetails.Tags)
                    {
                        <li class="tag">@tag</li>
                    }
                </ul>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(postdetails.Image))
        {
            <figure class="post-hero">
                <img src="@postdetails.Image" alt="" fetchpriority="high" decoding="async" />
            </figure>
        }

        <div class="prose">
            <Markdown MarkdownContent="@postdetails.Text" />
        </div>

        <SocialShare UrlToShare="@UriHelper.Uri.ToString()" TextToShare="@postdetails.Title" />
    </article>
}

@code {
    [Parameter]
    public required string slug { get; set; }

    public PostViewModel? postdetails;

    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadPostAsync();

    private async Task LoadPostAsync()
    {
        errorMessage = null;

        var result = await ContentService.GetPostAsync(slug);

        if (result.IsNotFound)
        {
            UriHelper.NavigateTo("404", replace: true);
            return;
        }

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        postdetails = result.Content is null ? null : new PostViewModel(result.Content);
    }
}
