@page "/about"
@inject IBlogContentService ContentService
@inject NavigationManager UriHelper

@if (errorMessage is not null)
{
    <ContentError ErrorMessage="@errorMessage" OnRetry="LoadAboutAsync" />
}
else if (aboutPage is not null)
{
    <Markdown MarkdownContent="@aboutPage.Text" />
}

@code {
    private PageModel? aboutPage;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadAboutAsync();

    private async Task LoadAboutAsync()
    {
        errorMessage = null;

        var result = await ContentService.GetMarkdownPageAsync<PageModel>("about");

        if (result.IsNotFound)
        {
            UriHelper.NavigateTo("404", replace: true);
            return;
        }

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        aboutPage = result.Content;
    }
}
