{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "routes": [
    {
      "route": "/post/*",
      "rewrite": "/api/post-shell"
    },
    {
      "route": "/rss.xml",
      "rewrite": "/api/rss.xml"
    },
    {
      "route": "/atom.xml",
      "rewrite": "/api/atom.xml"
    },
    {
      "route": "/sitemap.xml",
      "rewrite": "/api/sitemap.xml"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/rss.xml", "/atom.xml", "/sitemap.xml"]
  },
  "trailingSlash": "never"
}
