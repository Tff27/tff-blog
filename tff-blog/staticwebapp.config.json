{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "routes": [
    {
      "route": "/rss.xml",
      "rewrite": "/api/rss.xml"
    },
    {
      "route": "/atom.xml",
      "rewrite": "/api/atom.xml"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/rss.xml", "/atom.xml"]
  }
}
