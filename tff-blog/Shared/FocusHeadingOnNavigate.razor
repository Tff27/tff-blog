@inject IJSRuntime JS

@code {
    /// <summary>
    /// Focuses the page heading after an in-app navigation so keyboard and screen-reader users
    /// start at the new content. Unlike <see cref="FocusOnNavigate"/>, the initial render is
    /// skipped: opening the site must not steal focus (or scroll) to the home heading.
    /// </summary>
    [Parameter]
    public RouteData? RouteData { get; set; }

    [Parameter]
    public string Selector { get; set; } = "h1";

    private Type? previousPageType;
    private bool hasRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RouteData is null)
        {
            return;
        }

        var pageType = RouteData.PageType;

        if (!hasRendered)
        {
            hasRendered = true;
            previousPageType = pageType;
            return;
        }

        if (pageType == previousPageType)
        {
            return;
        }

        previousPageType = pageType;

        await JS.InvokeVoidAsync("Blazor._internal.domWrapper.focusBySelector", Selector);
    }
}
