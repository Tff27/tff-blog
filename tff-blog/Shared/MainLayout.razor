@inherits LayoutComponentBase

<div class="page">
    <header>
        <NavMenu />
    </header>

    <main>
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <ErrorComponent ErrorCodeText="500" ErrorText="Something went wrong while loading this page. Please try again later." />
            </ErrorContent>
        </ErrorBoundary>
    </main>
    <aside>
        <ErrorBoundary>
            <ChildContent>
                <AuthorComponent />
            </ChildContent>
            <ErrorContent></ErrorContent>
        </ErrorBoundary>
    </aside>

    <footer>
        <FooterComponent />
    </footer>
</div>
