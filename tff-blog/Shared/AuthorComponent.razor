@inject IBlogContentService ContentService

@if (author is not null)
{
    <section class="author-card" aria-labelledby="author-name">
        <img class="author-card__photo" src="@author.Photo" alt="" loading="lazy" decoding="async" />
        <div class="author-card__body">
            <p class="author-card__eyebrow">About the author</p>
            <h2 class="author-card__name" id="author-name">@author.Name</h2>
            <div class="author-card__bio">
                <Markdown MarkdownContent="@author.Text" />
            </div>
            <Social InvertColor="true" />
        </div>
    </section>
}

@code {
    public AuthorModel? author;

    protected override async Task OnInitializedAsync()
    {
        var result = await ContentService.GetMarkdownPageAsync<AuthorModel>("author");

        if (result.IsSuccess)
        {
            author = result.Content;
        }
    }
}
