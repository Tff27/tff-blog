@inject IBlogContentService ContentService

@if (author is not null)
{
    <div class="authorbar">
        <img class="photo" src="@author.Photo" alt="Author photo" />
        <p class="name">@author.Name</p>
        <Social />
        <Markdown MarkdownContent=@author.Text />
    </div>
}

@code {
    public AuthorModel? author;

    protected override async Task OnInitializedAsync()
    {
        var result = await ContentService.GetMarkdownPageAsync<AuthorModel>("author");

        if (result.IsSuccess)
        {
            author = result.Content;
        }
    }
}
