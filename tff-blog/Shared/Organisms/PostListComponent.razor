@using Tff.Blog.Client.ViewModels
@inject IBlogContentService ContentService

<div class="post-container">
    @if (errorMessage is not null)
    {
        <ContentError ErrorMessage="@errorMessage" OnRetry="LoadPostsAsync" />
    }
    else if (PostList is not null)
    {
        @foreach (var post in PostList.Posts)
        {
            <PostCardComponent Post="@post" />
        }
    }
</div>

@code {
    public PostListViewModel? PostList { get; set; }

    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadPostsAsync();

    private async Task LoadPostsAsync()
    {
        errorMessage = null;

        var result = await ContentService.GetPostsAsync();

        if (result.IsSuccess)
        {
            PostList = new PostListViewModel
            {
                Posts = result.Content ?? [],
            };
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }
}
