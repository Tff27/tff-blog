<div class="navbar @(isOpen ? "is-open" : null)">
    <div class="navbar-top">
        <NavLink class="brand" href="" Match="NavLinkMatch.All" aria-label="Tiago Fonseca - home">
            <img class="brand-logo" src="images/logo.png" alt="Tiago Fonseca" />
        </NavLink>

        <button type="button"
                class="navbar-toggler"
                aria-expanded="@(isOpen ? "true" : "false")"
                aria-controls="primary-navigation"
                aria-label="@(isOpen ? "Close navigation" : "Open navigation")"
                @onclick="ToggleNavMenu">
            <svg class="navbar-toggler-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <nav id="primary-navigation" class="navbar-menu" aria-label="Primary" @onclick="CloseNavMenu">
        <ul class="nav-list">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="about">About</NavLink>
            </li>
        </ul>
    </nav>
</div>

@code {
    private bool isOpen;

    private void ToggleNavMenu()
    {
        isOpen = !isOpen;
    }

    private void CloseNavMenu()
    {
        isOpen = false;
    }
}
